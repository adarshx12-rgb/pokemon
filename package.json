{
  "name": "pokemon-vault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify:showcase": "tsx scripts/verify-showcase.ts",
    "snapshot:showcase": "tsx scripts/snapshot-showcase.ts",
    "snapshot:pokedex": "tsx scripts/snapshot-pokedex.ts",
    "build:grail": "tsx scripts/build-grail-assets.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.0",
    "@opennextjs/cloudflare": "^1.20.10",
    "framer-motion": "^14.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.150.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true,
    "unrs-resolver@1.12.2": true
  }
}
